{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SpecimenUpdate",
    "description": "Request body for updating an existing specimen",
    "type": "object",
    "properties": {
        "latitude": {
            "type": "number",
            "description": "Latitude coordinate"
        },
        "longitude": {
            "type": "number",
            "description": "Longitude coordinate"
        },
        "circumference": {
            "type": "number",
            "description": "Circumference in centimeters"
        },
        "height": {
            "type": "number",
            "description": "Height in meters"
        },
        "healthStatus": {
            "$ref": "./health-status.schema.json"
        },
        "notes": {
            "type": "string",
            "description": "Observational notes"
        },
        "observationDate": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of observation"
        }
    },
    "additionalProperties": false
}
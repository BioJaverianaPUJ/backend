{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SpeciesResponse",
    "description": "Public representation of a species entity",
    "type": "object",
    "required": [
        "id",
        "scientificName",
        "commonName",
        "family",
        "woodDensity"
    ],
    "properties": {
        "id": {
            "type": "string",
            "format": "uuid",
            "description": "Species unique identifier"
        },
        "scientificName": {
            "type": "string",
            "description": "Scientific name of the species"
        },
        "commonName": {
            "type": "string",
            "description": "Common name of the species"
        },
        "family": {
            "type": "string",
            "description": "Family to which the species belongs"
        },
        "woodDensity": {
            "type": "number",
            "description": "Wood density of the species"
        }
    },
    "additionalProperties": false
}

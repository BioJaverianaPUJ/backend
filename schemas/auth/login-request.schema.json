{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LoginRequest",
    "description": "Request body for user login",
    "type": "object",
    "required": [
        "email",
        "password"
    ],
    "properties": {
        "email": {
            "type": "string",
            "format": "email",
            "minLength": 5,
            "maxLength": 100,
            "description": "User's email address"
        },
        "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "description": "User's password"
        }
    },
    "additionalProperties": false
}

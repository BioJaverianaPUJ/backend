{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LoginError",
    "description": "Authentication endpoint error response",
    "type": "object",
    "required": [
        "error",
        "message"
    ],
    "properties": {
        "error": {
            "type": "string",
            "enum": [
                "INVALID_CREDENTIALS",
                "ACCOUNT_LOCKED"
            ],
            "description": "Machine-readable authentication error code"
        },
        "message": {
            "type": "string",
            "description": "Human-readable error message"
        }
    },
    "additionalProperties": false
}

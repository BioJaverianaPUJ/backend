{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeUserUpdateRequest",
  "description": "Request body for updating the authenticated user's own profile.",
  "type": "object",
  "required": [
    "firstName",
    "lastName",
    "username"
  ],
  "properties": {
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 25
    },
    "gender": {
      "type": "string",
      "enum": ["MALE", "FEMALE", "OTHER"]
    },
    "profilePictureKey": {
      "type": "string"
    },
    "bannerKey": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "UserResponse",
    "description": "Public user representation",
    "type": "object",
    "required": [
        "userId",
        "username",
        "firstName",
        "lastName",
        "email",
        "role"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User's UUID"
        },
        "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
        },
        "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
        },
        "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 25,
            "description": "User's username"
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "role": {
            "type": "string",
            "enum": [
                "USER",
                "ADMIN"
            ]
        },
        "gender": {
            "type": "string",
            "enum": [
                "MALE",
                "FEMALE",
                "OTHER"
            ]
        },
        "profilePictureKey": {
            "type": "string",
            "description": "S3 key for the user's profile picture, if set"
        },
        "bannerKey": {
            "type": "string",
            "description": "S3 key for the user's banner image, if set"
        },
        "deactivated": {
            "type": "boolean",
            "description": "Whether the user account is deactivated"
        },
        "usernameLastUpdate": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the last username change"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the user was created"
        }
    },
    "additionalProperties": false
}

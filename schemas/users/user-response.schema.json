{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "UserResponse",
    "description": "Public user representation",
    "type": "object",
    "required": [
        "userId",
        "firstName",
        "lastName",
        "email",
        "role"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User's UUID"
        },
        "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
        },
        "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
        },
        "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 25,
            "description": "User's username"
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "role": {
            "type": "string",
            "enum": [
                "USER",
                "ADMIN"
            ]
        },
        "gender": {
            "type": "string",
            "enum": [
                "MALE",
                "FEMALE",
                "OTHER"
            ]
        }
    },
    "additionalProperties": false
}

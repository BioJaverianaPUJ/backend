{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserUpdateRequest",
  "description": "Request body for updating a user (admin or self).",
  "type": "object",
  "required": [
    "firstName",
    "lastName",
    "username"
  ],
  "properties": {
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 25
    },
    "role": {
      "type": "string",
      "enum": ["USER", "ADMIN"]
    },
    "gender": {
      "type": "string",
      "enum": ["MALE", "FEMALE", "OTHER"]
    },
    "enabled": {
      "type": "boolean"
    },
    "profilePictureKey": {
      "type": "string"
    },
    "bannerKey": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
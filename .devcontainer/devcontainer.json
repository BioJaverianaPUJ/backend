{
    "name": "Spring Boot",
    "dockerComposeFile": "../compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",
    "remoteUser": "root",
    
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-spring-boot"
            ]
        }
    },

    "forwardPorts": [
        8080,
        5432
    ]
}
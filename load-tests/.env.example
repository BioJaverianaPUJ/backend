# Copy this file to .env and fill in test-only values.
# The API, S3 and RabbitMQ URLs must resolve to loopback addresses only.
API_BASE_URL=http://127.0.0.1:8000
MOBILE_TOKEN=
ADMIN_TOKEN=

LOADTEST_DB_PASSWORD=
RUSTFS_TEST_ACCESS_KEY=
RUSTFS_TEST_SECRET_KEY=
LOADTEST_POSTGRES_PORT=15432
LOADTEST_RABBIT_PORT=5673
LOADTEST_RABBIT_MANAGEMENT_PORT=15673
LOADTEST_S3_PORT=19000
LOADTEST_RUSTFS_CONSOLE_PORT=19001

RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15673
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=observation.jobs
RABBITMQ_USER=loadtest
RABBITMQ_PASSWORD=
FAKE_WORKER_DELAY_SECONDS=0

TEST_IMAGE_PATH=C:\path\to\test-observation.jpg
TEST_IMAGE_CONTENT_TYPE=image/jpeg
TEST_LATITUDE=4.6280
TEST_LONGITUDE=-74.0640
PROCESSING_CONFIRM_TIMEOUT_SEC=
STATUS_POLL_INTERVAL_SEC=2
RABBITMQ_SAMPLE_INTERVAL_SEC=1

# Defaults represent the SRS workload. Change only for smoke tests.
DURATION=15m
MOBILE_VUS=50
ADMIN_VUS=3
OBSERVATION_RATE=10
